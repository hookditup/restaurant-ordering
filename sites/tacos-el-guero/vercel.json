{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/login",
      "destination": "/rewards",
      "permanent": true
    },
    {
      "source": "/account",
      "destination": "/rewards",
      "permanent": true
    },
    {
      "source": "/download-app",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/heber-city",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/gift-cards/check",
      "destination": "/gift-cards",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/questions",
      "permanent": true
    }
  ]
}